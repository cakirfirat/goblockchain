{
  "name": "flatunchain-desktop",
  "productName": "FlatunChain",
  "version": "0.4.0",
  "description": "FlatunChain masaüstü cüzdanı ve madencisi",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test/walletstore.test.js",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.flatunchain.desktop",
    "productName": "FlatunChain",
    "afterPack": "scripts/adhoc-sign.js",
    "files": [
      "main.js",
      "preload.js",
      "walletstore.js",
      "renderer/**",
      "assets/**"
    ],
    "extraResources": [
      {
        "from": "sidecar",
        "to": "sidecar"
      }
    ],
    "mac": {
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.finance"
    },
    "win": {
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "FlatunChain-Setup-${version}-${arch}.${ext}"
    },
    "linux": {
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Finance",
      "artifactName": "FlatunChain-${version}-${arch}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "playwright-core": "^1.61.1"
  }
}
